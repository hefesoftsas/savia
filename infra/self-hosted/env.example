SAVIA_PUBLIC_ORIGIN=http://localhost:8080
SAVIA_AUTH_SECRET=
SAVIA_ENCRYPTION_KEY=
SAVIA_CAPTCHA_SECRET=
SAVIA_BOOTSTRAP_EMAIL=
SAVIA_BOOTSTRAP_PASSWORD=
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=savia-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
