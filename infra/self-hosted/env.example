SAVIA_PUBLIC_ORIGIN=http://localhost:8080
SAVIA_AUTH_SECRET=
SAVIA_ENCRYPTION_KEY=
SAVIA_CAPTCHA_SECRET=
SAVIA_BOOTSTRAP_EMAIL=
SAVIA_BOOTSTRAP_PASSWORD=
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=savia-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional SMTP and integration settings are documented in docs/guides/self-hosted-docker.md.

# Optional local Pages semantic search (the search Compose override sets these).
# SAVIA_PAGES_SEARCH_ENABLED=true
# SAVIA_PAGES_OLLAMA_URL=http://ollama:11434
# SAVIA_PAGES_QDRANT_URL=http://qdrant:6333
# SAVIA_PAGES_QDRANT_COLLECTION=savia-pages-bge-m3-v1
# SAVIA_PAGES_QDRANT_API_KEY=
# SAVIA_PAGES_EMBEDDING_TIMEOUT_MS=60000

# Optional PostgreSQL runtime (see docs/guides/self-hosted-postgres.md).
SAVIA_DATABASE_DRIVER=sqlite
# SAVIA_POSTGRES_URL=postgresql://savia:YOUR_PASSWORD@postgres:5432/savia
# POSTGRES_PASSWORD=YOUR_PASSWORD
# SAVIA_POSTGRES_POOL_SIZE=5

# Optional private plugin registry; exact local tenant mappings, server-only tokens.
# PLUGIN_REGISTRY_TENANTS={"tenant:1":{"url":"https://registry.example.com","token":"<read-only-token-at-least-32-characters>"}}
