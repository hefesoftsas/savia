{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "savia-domain-transition",
  "main": "domain-transition.mjs",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "savia.hefesoft.com/*", "zone_name": "hefesoft.com" },
    { "pattern": "*.savia.hefesoft.com/*", "zone_name": "hefesoft.com" },
  ],
}
