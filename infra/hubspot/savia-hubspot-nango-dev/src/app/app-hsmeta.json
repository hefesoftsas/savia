{
  "uid": "savia_hubspot_nango_dev_app",
  "type": "app",
  "config": {
    "description": "OAuth bridge between Savia CRM connections and the development Nango environment.",
    "name": "Savia HubSpot CRM (Development)",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://nango.cloud.hefesoft.com/oauth/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.companies.read",
        "crm.objects.deals.read",
        "crm.objects.companies.write",
        "crm.objects.deals.write",
        "crm.objects.tickets.read",
        "crm.objects.tickets.write",
        "crm.objects.products.read",
        "crm.objects.products.write",
        "crm.objects.line_items.read",
        "crm.objects.line_items.write",
        "crm.objects.quotes.read",
        "crm.objects.quotes.write",
        "crm.objects.owners.read",
        "sales-email-read"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support",
      "supportPhone": "+18005555555"
    }
  }
}
