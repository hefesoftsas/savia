{
  "format": "savia.solution",
  "formatVersion": 1,
  "id": "savia.insurance-management",
  "version": "1.0.0",
  "label": "Seguros",
  "description": "Clientes, aseguradoras, pólizas, pagos y siniestros. Se instala sin el Cotizador.",
  "requires": [],
  "objects": [
    {
      "name": "clientes",
      "label": "Clientes",
      "description": "Personas y empresas aseguradas.",
      "config": {
        "version": 2,
        "fields": {
          "name": {
            "type": "Textbox",
            "label": "Nombre",
            "required": true,
            "labels": {
              "en": "Name",
              "pt": "Nome"
            }
          },
          "documento": {
            "type": "Textbox",
            "label": "Documento",
            "labels": {
              "en": "Document",
              "pt": "Documento"
            }
          },
          "email": {
            "type": "Textbox",
            "label": "Correo",
            "config": {
              "format": "email"
            },
            "labels": {
              "en": "Email",
              "pt": "E-mail"
            }
          },
          "telefono": {
            "type": "Textbox",
            "label": "Teléfono",
            "labels": {
              "en": "Phone",
              "pt": "Telefone"
            }
          }
        },
        "fieldOrder": ["name", "documento", "email", "telefono"]
      },
      "labels": {
        "en": "Customers",
        "pt": "Clientes"
      },
      "descriptions": {
        "en": "Insured people and companies.",
        "pt": "Pessoas e empresas seguradas."
      }
    },
    {
      "name": "aseguradoras",
      "label": "Aseguradoras",
      "description": "Compañías y contactos comerciales.",
      "config": {
        "version": 2,
        "fields": {
          "name": {
            "type": "Textbox",
            "label": "Nombre",
            "required": true,
            "labels": {
              "en": "Name",
              "pt": "Nome"
            }
          },
          "codigo": {
            "type": "Textbox",
            "label": "Código",
            "labels": {
              "en": "Code",
              "pt": "Código"
            }
          },
          "contacto": {
            "type": "Textbox",
            "label": "Contacto",
            "labels": {
              "en": "Contact",
              "pt": "Contato"
            }
          }
        },
        "fieldOrder": ["name", "codigo", "contacto"]
      },
      "labels": {
        "en": "Insurers",
        "pt": "Seguradoras"
      },
      "descriptions": {
        "en": "Insurance companies and business contacts.",
        "pt": "Companhias e contatos comerciais."
      }
    },
    {
      "name": "polizas",
      "label": "Pólizas",
      "description": "Vigencias y condiciones de los contratos.",
      "config": {
        "version": 2,
        "fields": {
          "name": {
            "type": "Textbox",
            "label": "Número de póliza",
            "required": true,
            "labels": {
              "en": "Policy number",
              "pt": "Número da apólice"
            }
          },
          "cliente": {
            "type": "Dropdown",
            "label": "Cliente",
            "options": [],
            "config": {
              "relation": "clientes"
            },
            "labels": {
              "en": "Customer",
              "pt": "Cliente"
            }
          },
          "aseguradora": {
            "type": "Dropdown",
            "label": "Aseguradora",
            "options": [],
            "config": {
              "relation": "aseguradoras"
            },
            "labels": {
              "en": "Insurer",
              "pt": "Seguradora"
            }
          },
          "cotizacion": {
            "type": "Textbox",
            "label": "Cotización",
            "labels": {
              "en": "Quote",
              "pt": "Cotação"
            }
          },
          "inicio": {
            "type": "DateControl",
            "label": "Inicio de vigencia",
            "labels": {
              "en": "Coverage start",
              "pt": "Início da vigência"
            }
          },
          "fin": {
            "type": "DateControl",
            "label": "Fin de vigencia",
            "labels": {
              "en": "Coverage end",
              "pt": "Fim da vigência"
            }
          },
          "prima": {
            "type": "Number",
            "label": "Prima",
            "config": {
              "format": "currency"
            },
            "labels": {
              "en": "Premium",
              "pt": "Prêmio"
            }
          },
          "estado": {
            "type": "Dropdown",
            "label": "Estado",
            "options": [
              {
                "label": "Vigente",
                "value": "Vigente",
                "labels": {
                  "en": "Active",
                  "pt": "Vigente"
                }
              },
              {
                "label": "Vencida",
                "value": "Vencida",
                "labels": {
                  "en": "Expired",
                  "pt": "Vencida"
                }
              },
              {
                "label": "Cancelada",
                "value": "Cancelada",
                "labels": {
                  "en": "Cancelled",
                  "pt": "Cancelada"
                }
              }
            ],
            "labels": {
              "en": "Status",
              "pt": "Status"
            }
          }
        },
        "fieldOrder": [
          "name",
          "cliente",
          "aseguradora",
          "cotizacion",
          "inicio",
          "fin",
          "prima",
          "estado"
        ]
      },
      "labels": {
        "en": "Policies",
        "pt": "Apólices"
      },
      "descriptions": {
        "en": "Policy terms and contract conditions.",
        "pt": "Vigências e condições dos contratos."
      }
    },
    {
      "name": "pagos",
      "label": "Pagos",
      "description": "Seguimiento de recaudos por póliza.",
      "config": {
        "version": 2,
        "fields": {
          "name": {
            "type": "Textbox",
            "label": "Referencia",
            "required": true,
            "labels": {
              "en": "Reference",
              "pt": "Referência"
            }
          },
          "poliza": {
            "type": "Dropdown",
            "label": "Póliza",
            "options": [],
            "config": {
              "relation": "polizas"
            },
            "labels": {
              "en": "Policy",
              "pt": "Apólice"
            }
          },
          "valor": {
            "type": "Number",
            "label": "Valor",
            "config": {
              "format": "currency"
            },
            "labels": {
              "en": "Amount",
              "pt": "Valor"
            }
          },
          "fecha": {
            "type": "DateControl",
            "label": "Fecha",
            "labels": {
              "en": "Date",
              "pt": "Data"
            }
          },
          "estado": {
            "type": "Dropdown",
            "label": "Estado",
            "options": [
              {
                "label": "Pendiente",
                "value": "Pendiente",
                "labels": {
                  "en": "Pending",
                  "pt": "Pendente"
                }
              },
              {
                "label": "Pagado",
                "value": "Pagado",
                "labels": {
                  "en": "Paid",
                  "pt": "Pago"
                }
              },
              {
                "label": "Anulado",
                "value": "Anulado",
                "labels": {
                  "en": "Void",
                  "pt": "Anulado"
                }
              }
            ],
            "labels": {
              "en": "Status",
              "pt": "Status"
            }
          }
        },
        "fieldOrder": ["name", "poliza", "valor", "fecha", "estado"]
      },
      "labels": {
        "en": "Payments",
        "pt": "Pagamentos"
      },
      "descriptions": {
        "en": "Per-policy collection tracking.",
        "pt": "Acompanhamento de recebimentos por apólice."
      }
    },
    {
      "name": "siniestros",
      "label": "Siniestros",
      "description": "Avisos y seguimiento de reclamaciones.",
      "config": {
        "version": 2,
        "fields": {
          "name": {
            "type": "Textbox",
            "label": "Referencia",
            "required": true,
            "labels": {
              "en": "Reference",
              "pt": "Referência"
            }
          },
          "poliza": {
            "type": "Dropdown",
            "label": "Póliza",
            "options": [],
            "config": {
              "relation": "polizas"
            },
            "labels": {
              "en": "Policy",
              "pt": "Apólice"
            }
          },
          "fecha": {
            "type": "DateControl",
            "label": "Fecha del siniestro",
            "labels": {
              "en": "Claim date",
              "pt": "Data do sinistro"
            }
          },
          "descripcion": {
            "type": "Textarea",
            "label": "Descripción",
            "labels": {
              "en": "Description",
              "pt": "Descrição"
            }
          },
          "valor": {
            "type": "Number",
            "label": "Valor reclamado",
            "config": {
              "format": "currency"
            },
            "labels": {
              "en": "Claimed amount",
              "pt": "Valor reclamado"
            }
          },
          "estado": {
            "type": "Dropdown",
            "label": "Estado",
            "options": [
              {
                "label": "Reportado",
                "value": "Reportado",
                "labels": {
                  "en": "Reported",
                  "pt": "Reportado"
                }
              },
              {
                "label": "En estudio",
                "value": "En estudio",
                "labels": {
                  "en": "Under review",
                  "pt": "Em análise"
                }
              },
              {
                "label": "Aprobado",
                "value": "Aprobado",
                "labels": {
                  "en": "Approved",
                  "pt": "Aprovado"
                }
              },
              {
                "label": "Rechazado",
                "value": "Rechazado",
                "labels": {
                  "en": "Rejected",
                  "pt": "Rejeitado"
                }
              },
              {
                "label": "Cerrado",
                "value": "Cerrado",
                "labels": {
                  "en": "Closed",
                  "pt": "Encerrado"
                }
              }
            ],
            "labels": {
              "en": "Status",
              "pt": "Status"
            }
          }
        },
        "fieldOrder": [
          "name",
          "poliza",
          "fecha",
          "descripcion",
          "valor",
          "estado"
        ]
      },
      "labels": {
        "en": "Claims",
        "pt": "Sinistros"
      },
      "descriptions": {
        "en": "Claim notices and follow-up.",
        "pt": "Avisos e acompanhamento de sinistros."
      }
    }
  ],
  "labels": {
    "en": "Insurance management",
    "pt": "Gestão de seguros"
  },
  "descriptions": {
    "en": "Customers, insurers, policies, payments, and claims. Installs independently of the quote wizard.",
    "pt": "Clientes, seguradoras, apólices, pagamentos e sinistros. Instala-se independentemente do cotador."
  }
}
