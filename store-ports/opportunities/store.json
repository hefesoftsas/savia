        "product": {
          "types": [
            "Textbox"
          ]
        },
        "source": {
          "types": [
            "Dropdown"
          ],
          "optionValues": [
            "referral",
            "inbound",
            "outbound",
            "existing"
          ]
        },
        "target_date": {
          "types": [
            "DateControl"
          ],
          "required": true
        },
        "premium": {
          "types": [
            "Number"
          ],
          "required": true
        },
        "probability": {
          "types": [
            "Number"
          ],
          "required": true
        },
        "next_follow_up": {
          "types": [
            "DateControl"
          ]
        },
        "outcome": {
          "types": [
            "Textbox"
          ]
        },
        "stage": {
          "types": [
            "Dropdown"
          ],
          "required": true,
          "optionValues": [
            "lead",
            "qualified",
            "proposal",
            "negotiation",
            "won",
            "lost"
          ]
        },
        "notes": {
          "types": [
            "Textarea"
          ]
        }
      }
    }
  ],
  "screens": [
    {
      "object": "insurance_opportunities",
      "view": "records"
    }
  ]
