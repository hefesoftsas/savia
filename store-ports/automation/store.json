      "collections": [
        "insurance_renewals",
        "insurance_activities"
      ],
      "fields": [
        {
          "collection": "insurance_activities",
          "fields": {
            "source_renewal_id": {
              "type": "Dropdown",
              "label": "Renovación de origen",
              "labels": {},
              "config": {
                "relation": "insurance_renewals",
                "onDelete": "restrict",
                "unique": true
              }
            }
          }
        }
      ],
      "workflows": [
        {
          "key": "created",
          "name": "Seguimiento de renovación",
          "definition": {
            "trigger": {
              "type": "created",
              "collection": "insurance_renewals"
            },
            "nodes": [
              {
                "id": "not_renewed",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "neq",
                "right": "renewed",
                "next": "not_lost"
              },
              {
                "id": "not_lost",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "neq",
                "right": "lost",
                "next": "wait"
              },
              {
                "id": "wait",
                "type": "delay",
                "until": {
                  "dateOffset": {
                    "value": {
                      "ref": "trigger.expiry_date"
                    },
                    "days": -30
                  }
                },
                "next": "current"
              },
              {
                "id": "current",
                "type": "query",
                "collection": "insurance_renewals",
                "field": "id",
                "value": {
                  "ref": "trigger.id"
                },
                "limit": 1,
                "next": "has_current"
              },
              {
                "id": "has_current",
                "type": "condition",
                "left": {
                  "ref": "steps.current.count"
                },
                "operator": "gt",
                "right": 0,
                "next": "still_open"
              },
              {
                "id": "still_open",
                "type": "condition",
                "left": {
                  "ref": "steps.current.records.0.stage"
                },
                "operator": "neq",
                "right": "renewed",
                "next": "still_active"
              },
              {
                "id": "still_active",
                "type": "condition",
                "left": {
                  "ref": "steps.current.records.0.stage"
                },
                "operator": "neq",
                "right": "lost",
                "next": "exists"
              },
              {
                "id": "exists",
                "type": "condition",
                "left": {
                  "ref": "steps.current.records.0.id"
                },
                "operator": "eq",
                "right": {
                  "ref": "trigger.id"
                },
                "next": "create"
              },
              {
                "id": "create",
                "type": "create",
                "collection": "insurance_activities",
                "matchField": "source_renewal_id",
                "values": {
                  "name": {
                    "ref": "trigger.name"
                  },
                  "customer": {
                    "ref": "trigger.customer"
                  },
                  "policy_reference": {
                    "ref": "trigger.policy_reference"
                  },
                  "owner": {
                    "ref": "system.owner"
                  },
                  "due_date": {
                    "dateOffset": {
                      "value": {
                        "ref": "trigger.expiry_date"
                      },
                      "days": -30
                    }
                  },
                  "kind": "call",
                  "importance": "normal",
                  "stage": "scheduled",
                  "source_renewal_id": {
                    "ref": "trigger.id"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ]
}