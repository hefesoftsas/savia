    {
      "id": "insurance.policy-renewal",
      "label": "Póliza → renovación",
      "description": "Crea una renovación por vigencia de póliza vigente al crearla o actualizar sus datos. Requiere cliente, vencimiento y prima. Los casos existentes no se sobrescriben.",
      "collections": [
        "clientes",
        "polizas",
        "insurance_renewals"
      ],
      "fields": [
        {
          "collection": "polizas",
          "fields": {
            "cliente": {
              "type": "Dropdown",
              "label": "Cliente vinculado",
              "labels": {},
              "config": {
                "relation": "clientes",
                "onDelete": "restrict"
              }
            }
          }
        },
        {
          "collection": "insurance_renewals",
          "fields": {
            "customer_id": {
              "type": "Dropdown",
              "label": "Cliente vinculado",
              "labels": {},
              "config": {
                "relation": "clientes",
                "onDelete": "restrict"
              }
            },
            "source_policy_id": {
              "type": "Dropdown",
              "label": "Póliza de origen",
              "labels": {},
              "config": {
                "relation": "polizas",
                "onDelete": "restrict",
                "unique": true
              }
            },
            "term_policy_id": {
              "type": "Dropdown",
              "label": "Póliza de esta vigencia",
              "labels": {},
              "config": {
                "relation": "polizas",
                "onDelete": "restrict"
              }
            },
            "term_key": {
              "type": "Textbox",
              "label": "Clave de vigencia",
              "labels": {},
              "config": {
                "unique": true,
                "maxLength": 200
              }
            }
          }
        }
      ],
      "workflows": [
        {
          "key": "created",
          "name": "Póliza a renovación · nuevos",
          "definition": {
            "trigger": {
              "type": "created",
              "collection": "polizas"
            },
            "nodes": [
              {
                "id": "active",
                "type": "condition",
                "left": {
                  "ref": "trigger.estado"
                },
                "operator": "eq",
                "right": "Vigente",
                "next": "customer"
              },
              {
                "id": "customer",
                "type": "query",
                "collection": "clientes",
                "field": "id",
                "value": {
                  "ref": "trigger.cliente"
                },
                "limit": 1,
                "next": "legacy"
              },
              {
                "id": "legacy",
                "type": "query",
                "collection": "insurance_renewals",
                "field": "source_policy_id",
                "value": {
                  "ref": "trigger.id"
                },
                "limit": 1,
                "next": "has_legacy"
              },
              {
                "id": "has_legacy",
                "type": "condition",
                "left": {
                  "ref": "steps.legacy.count"
                },
                "operator": "gt",
                "right": 0,
                "next": "new_term",
                "otherwise": "create"
              },
              {
                "id": "new_term",
                "type": "condition",
                "left": {
                  "ref": "steps.legacy.records.0.expiry_date"
                },
                "operator": "neq",
                "right": {
                  "ref": "trigger.fin"
                },
                "next": "create"
              },
              {
                "id": "create",
                "type": "create",
                "collection": "insurance_renewals",
                "matchField": "term_key",
                "values": {
                  "name": {
                    "ref": "trigger.name"
                  },
                  "customer": {
                    "ref": "steps.customer.records.0.name"
                  },
                  "customer_id": {
                    "ref": "trigger.cliente"
                  },
                  "term_policy_id": {
                    "ref": "trigger.id"
                  },
                  "term_key": {
                    "concat": [
                      {
                        "ref": "trigger.id"
                      },
                      ":",
                      {
                        "ref": "trigger.fin"
                      }
                    ]
                  },
                  "next_follow_up": {
                    "dateOffset": {
                      "value": {
                        "ref": "trigger.fin"
                      },
                      "days": -30
                    }
                  },
                  "policy_reference": {
                    "ref": "trigger.name"
                  },
                  "expiry_date": {
                    "ref": "trigger.fin"
                  },
                  "premium": {
                    "ref": "trigger.prima"
                  },
                  "stage": "pending",
                  "owner": {
                    "ref": "system.owner"
                  }
                }
              }
            ]
          }
        },
        {
          "key": "updated",
          "name": "Póliza a renovación · cambios",
          "definition": {
            "trigger": {
              "type": "updated",
              "collection": "polizas",
              "changedFields": [
                "fin",
                "prima",
                "estado",
                "cliente"
              ]
            },
            "nodes": [
              {
                "id": "active",
                "type": "condition",
                "left": {
                  "ref": "trigger.estado"
                },
                "operator": "eq",
                "right": "Vigente",
                "next": "customer"
              },
              {
                "id": "customer",
                "type": "query",
                "collection": "clientes",
                "field": "id",
                "value": {
                  "ref": "trigger.cliente"
                },
                "limit": 1,
                "next": "legacy"
              },
              {
                "id": "legacy",
                "type": "query",
                "collection": "insurance_renewals",
                "field": "source_policy_id",
                "value": {
                  "ref": "trigger.id"
                },
                "limit": 1,
                "next": "has_legacy"
              },
              {
                "id": "has_legacy",
                "type": "condition",
                "left": {
                  "ref": "steps.legacy.count"
                },
                "operator": "gt",
                "right": 0,
                "next": "new_term",
                "otherwise": "create"
              },
              {
                "id": "new_term",
                "type": "condition",
                "left": {
                  "ref": "steps.legacy.records.0.expiry_date"
                },
                "operator": "neq",
                "right": {
                  "ref": "trigger.fin"
                },
                "next": "create"
              },
              {
                "id": "create",
                "type": "create",
                "collection": "insurance_renewals",
                "matchField": "term_key",
                "values": {
                  "name": {
                    "ref": "trigger.name"
                  },
                  "customer": {
                    "ref": "steps.customer.records.0.name"
                  },
                  "customer_id": {
                    "ref": "trigger.cliente"
                  },
                  "term_policy_id": {
                    "ref": "trigger.id"
                  },
                  "term_key": {
                    "concat": [
                      {
                        "ref": "trigger.id"
                      },
                      ":",
                      {
                        "ref": "trigger.fin"
                      }
                    ]
                  },
                  "next_follow_up": {
                    "dateOffset": {
                      "value": {
                        "ref": "trigger.fin"
                      },
                      "days": -30
                    }
                  },
                  "policy_reference": {
                    "ref": "trigger.name"
                  },
                  "expiry_date": {
                    "ref": "trigger.fin"
                  },
                  "premium": {
                    "ref": "trigger.prima"
                  },
                  "stage": "pending",
                  "owner": {
                    "ref": "system.owner"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "insurance.opportunity-issuance",
      "label": "Oportunidad ganada → emisión",
      "description": "Crea una solicitud por oportunidad ganada con vigencia acordada y prima positiva. Repite la preparación para reparar campos faltantes; no reemplaza flujos editados.",
