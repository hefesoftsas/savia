{
  "format": "savia.store",
  "formatVersion": 1,
  "bundles": [
    {
      "id": "insurance.issuance-policy",
      "label": "Emisión → póliza",
      "description": "Crea la póliza nativa de una emisión expedida, una sola vez; conserva pólizas existentes.",
      "collections": [
        "insurance_issuance",
        "polizas"
      ],
      "fields": [
        {
          "collection": "polizas",
          "fields": {
            "source_issuance_id": {
              "type": "Dropdown",
              "label": "Emisión de origen",
              "labels": {},
              "config": {
                "relation": "insurance_issuance",
                "onDelete": "restrict",
                "unique": true
              }
            },
            "cliente": {
              "type": "Dropdown",
              "label": "Cliente vinculado",
              "labels": {},
              "config": {
                "relation": "clientes",
                "onDelete": "restrict"
              }
            }
          }
        }
      ],
      "workflows": [
        {
          "key": "created",
          "name": "Emisión a póliza · nuevos",
          "definition": {
            "trigger": {
              "type": "created",
              "collection": "insurance_issuance"
            },
            "nodes": [
              {
                "id": "issued",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "eq",
                "right": "issued",
                "next": "dates",
                "otherwise": "delivered"
              },
              {
                "id": "delivered",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "eq",
                "right": "delivered",
                "next": "dates"
              },
              {
                "id": "dates",
                "type": "condition",
                "left": {
                  "ref": "trigger.end_date"
                },
                "operator": "date_after",
                "right": {
                  "ref": "trigger.effective_date"
                },
                "next": "create"
              },
              {
                "id": "create",
                "type": "create",
                "collection": "polizas",
                "matchField": "source_issuance_id",
                "values": {
                  "name": {
                    "ref": "trigger.policy_reference"
                  },
                  "inicio": {
                    "ref": "trigger.effective_date"
                  },
                  "fin": {
                    "ref": "trigger.end_date"
                  },
                  "prima": {
                    "ref": "trigger.premium"
                  },
                  "estado": "Vigente",
                  "cliente": {
                    "ref": "trigger.customer_id"
                  },
                  "source_issuance_id": {
                    "ref": "trigger.id"
                  }
                }
              }
            ]
          }
        },
        {
          "key": "updated",
          "name": "Emisión a póliza · cambios",
          "definition": {
            "trigger": {
              "type": "updated",
              "collection": "insurance_issuance",
              "changedFields": [
                "stage",
                "policy_reference",
                "effective_date",
                "end_date",
                "premium"
              ]
            },
            "nodes": [
              {
                "id": "issued",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "eq",
                "right": "issued",
                "next": "dates",
                "otherwise": "delivered"
              },
              {
                "id": "delivered",
                "type": "condition",
                "left": {
                  "ref": "trigger.stage"
                },
                "operator": "eq",
                "right": "delivered",
                "next": "dates"
              },
              {
                "id": "dates",
                "type": "condition",
                "left": {
                  "ref": "trigger.end_date"
                },
                "operator": "date_after",
                "right": {
                  "ref": "trigger.effective_date"
                },
                "next": "create"
              },
              {
                "id": "create",
                "type": "create",
                "collection": "polizas",
                "matchField": "source_issuance_id",
                "values": {
                  "name": {
                    "ref": "trigger.policy_reference"
                  },
                  "inicio": {
                    "ref": "trigger.effective_date"
                  },
                  "fin": {
                    "ref": "trigger.end_date"
                  },
                  "prima": {
                    "ref": "trigger.premium"
                  },
                  "estado": "Vigente",
                  "cliente": {
                    "ref": "trigger.customer_id"
                  },
                  "source_issuance_id": {
                    "ref": "trigger.id"
                  }
                }
              }
            ]
          }
        }
      ]
    },
