{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development only. Production uses the manifest rendered from
  // infra/pulumi/shared-registry stack outputs.
  "name": "savia-plugin-registry-local",
  "compatibility_date": "2026-08-31",
  "main": "src/index.ts",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "PLUGIN_REGISTRY",
      "bucket_name": "savia-plugin-registry-local",
    },
  ],
}
