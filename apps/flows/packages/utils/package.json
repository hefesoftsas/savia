    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@savia/flows-types": "workspace:*",
    "d3-geo": "3.1.1"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
