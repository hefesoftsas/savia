{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savia-flows",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": { "iconv-lite": "./src/stubs/empty-module.ts" },
  "define": { "RUNTIME_VERSION": "\"savia-local-66be308\"" },
  "vars": {
    "SAVIA_FLOWS_LOCAL_ONLY": "true",
    "CLOUDFLARE_ENV": "development",
    "WEB_HOST": "http://127.0.0.1:5173/flows-ui",
    "WEBSITE_URL": "http://127.0.0.1:5173",
    "EMAIL_DOMAIN": "savia.local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "savia-flows-local",
      "database_id": "00000000-0000-0000-0000-000000000095",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "savia-flows-local" }],
  "services": [
    {
      "binding": "CODE_EXECUTOR",
      "service": "savia-hook-executor",
      "entrypoint": "FlowsExecutor",
    },
  ],
  "r2_buckets": [
    { "binding": "RESSOURCES", "bucket_name": "savia-flows-resources" },
    { "binding": "DATASETS", "bucket_name": "savia-flows-datasets" },
    { "binding": "INBOXES", "bucket_name": "savia-flows-inboxes" },
  ],
  "workflows": [
    {
      "binding": "EXECUTE",
      "name": "savia-flows-local",
      "class_name": "Runtime",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DATABASE", "class_name": "DatabaseDO" },
      { "name": "WORKFLOW_AGENT", "class_name": "WorkflowAgent" },
      { "name": "AGENT_RUNNER", "class_name": "AgentRunner" },
      { "name": "EMAIL_AGENT_RUNNER", "class_name": "EmailAgentRunner" },
      { "name": "MAILBOX", "class_name": "MailboxDO" },
    ],
  },
  "migrations": [
    {
      "tag": "savia-local-v1",
      "new_sqlite_classes": [
        "DatabaseDO",
        "WorkflowAgent",
        "AgentRunner",
        "EmailAgentRunner",
        "MailboxDO",
      ],
    },
  ],
  "queues": {
    "producers": [
      { "binding": "WORKFLOW_QUEUE", "queue": "savia-flows-local" },
    ],
    "consumers": [
      {
        "queue": "savia-flows-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_DEFAULT",
      "namespace_id": "7001",
      "simple": { "limit": 1000, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "7002",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_EXECUTE",
      "namespace_id": "7003",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
