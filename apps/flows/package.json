{
  "name": "@savia/flows",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build": "pnpm run build:api && pnpm --filter @savia/flows-app build",
    "test": "node scripts/build-api.mjs && pnpm --filter @savia/flows-app build && node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:runtime": "pnpm --filter @savia/flows-runtime test",
    "typecheck": "pnpm --filter @savia/flows-api typecheck && pnpm --filter @savia/flows-app typecheck",
    "verify:source": "node scripts/verify-source.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260828.0-alpha"
  }
}
