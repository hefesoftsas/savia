{
  // Local development only. Preview deployment uses wrangler.preview.jsonc
  // rendered from the infrastructure project.
  "name": "savia-plugin-editor-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "assets": {
    "directory": "../admin/dist-plugin-editor",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
}
