{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "savia",
  "main": "src/edge-gateway.ts",
  "compatibility_date": "2026-08-31",
  "vars": { "CANONICAL_HOST": "savia.hefesoft.com" },
  "routes": [
    { "pattern": "savia.hefesoft.com", "custom_domain": true },
    { "pattern": "savia.hefesoft.com/*", "zone_name": "hefesoft.com" },
    { "pattern": "*.savia.hefesoft.com/*", "zone_name": "hefesoft.com" },
    { "pattern": "savia.app.hefesoft.com", "custom_domain": true },
    { "pattern": "savia-team.savia.app.hefesoft.com", "custom_domain": true },
    { "pattern": "*.savia.app.hefesoft.com/*", "zone_name": "hefesoft.com" },
  ],
  "services": [{ "binding": "API", "service": "savia-agencies" }],
  "r2_buckets": [
    { "binding": "OFFICE_RUNTIME", "bucket_name": "savia-documents" },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
