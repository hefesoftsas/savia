{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "savia-preview",
  "main": "src/edge-gateway.ts",
  "compatibility_date": "2026-08-31",
  "vars": { "CANONICAL_HOST": "savia-preview.hefesoft.com" },
  "routes": [
    { "pattern": "savia-preview.hefesoft.com", "custom_domain": true },
    {
      "pattern": "*.savia-preview.hefesoft.com/*",
      "zone_name": "hefesoft.com",
    },
  ],
  "services": [{ "binding": "API", "service": "savia-agencies-preview" }],
  "r2_buckets": [
    {
      "binding": "OFFICE_RUNTIME",
      "bucket_name": "savia-documents-preview",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
