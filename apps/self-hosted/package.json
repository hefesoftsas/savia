{
  "name": "@savia/self-hosted",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run --maxWorkers=1",
    "test:email": "tsx scripts/account-email-smoke.ts",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "tsx src/postgres/import-cli.ts",
    "test:postgres": "SAVIA_POSTGRES_TEST_REQUIRED=1 vitest run --maxWorkers=1",
    "test:sso": "tsx scripts/saml-keycloak-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hono/node-server": "^1.19.9",
    "@savia/studio-server": "workspace:*",
    "@savia/db": "workspace:*",
    "@savia/tenant-host": "workspace:*",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.9",
    "pg": "^8.18.0",
    "quickjs-emscripten": "^0.31.0",
    "tsx": "^4.21.0",
    "undici": "^7.29.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
